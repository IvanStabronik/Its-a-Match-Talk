# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat (оба ключа с первого дня)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your-ios-public-key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your-android-public-key

# Analytics (optional in dev)
EXPO_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
EXPO_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Error monitoring (optional in dev)
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Supabase Edge Functions (server-side only — НЕ в Expo app)
# SUPABASE_SERVICE_ROLE_KEY=...
# OPENAI_API_KEY=sk-...
# YANDEX_GPT_API_KEY=...          # альтернатива OpenAI для РФ
# REVENUECAT_WEBHOOK_SECRET=...
# MOCK_AI_PROVIDER=true           # dev/CI без реального AI
